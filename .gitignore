# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Secrets / environment
.env
*.key
*.pem
credentials*
secrets/

# Large / generated data (raw immutable files live in data/raw but are NOT committed)
data/raw/*
!data/raw/README.md
data/intermediate/*
!data/intermediate/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results (all regenerated by scripts)
results/tables/*
results/figures/*
results/reports/*
!results/tables/.gitkeep
!results/figures/.gitkeep
!results/reports/.gitkeep

# Compressed / binary genomic files
*.gz
*.bgz
*.vcf
*.vcf.gz
*.tbi
*.bcf
*.csi
*.bam
*.bai
*.fasta
*.fa
*.fastq
*.pkl
*.parquet

# OS
.DS_Store
