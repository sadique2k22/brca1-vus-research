# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Secrets / environment
.env
*.key
*.pem
credentials*
secrets/

# Large raw downloads (immutable; provenance tracked in data/raw/metadata.json + README.md)
data/raw/*.gz
data/raw/*.md5
data/raw/*.zip
*.zip

# Phase 13B raw tables (regenerable from public sources; provenance in DATA_PROVENANCE.md)
data/raw/bayesdel/*.txt
data/raw/alphamissense/*.tsv.gz
data/raw/revel/*.zip
data/raw/revel/*.log

# Regenerable intermediate files (re-derived from raw via src/clinvar.py)
data/intermediate/*
!data/intermediate/.gitkeep

# Compressed / binary genomic files (anywhere)
*.gz
*.bgz
*.vcf
*.vcf.gz
*.tbi
*.bcf
*.csi
*.bam
*.bai
*.fasta
*.fa
*.fastq
*.pkl
*.parquet

# OS
.DS_Store
